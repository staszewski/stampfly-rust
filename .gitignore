# Rust build output
/target/
**/target/

# The firmware root lockfile is committed. Nested library lockfiles are
# generated only when those crates are tested directly.
/crates/*/Cargo.lock

# ESP-IDF build/cache output generated by esp-idf-sys/embuild
/.embuild/

# Local editor and OS files
.DS_Store
.vscode/
.idea/
*.swp
*.swo

# Local environment files
.env
.env.*

# Logs and temporary files
*.log
*.tmp
*.profraw
*.rs.bk
/coverage/

# Local flight recordings are large experimental artifacts, not source.
/runs/
